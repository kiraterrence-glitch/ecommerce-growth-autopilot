# Local development defaults. Never commit real credentials.
APP_ENV=development
LOCAL_API_HOST=127.0.0.1
LOCAL_API_PORT=3001

# Keep mock as the repository default so CI/tests never require a live LLM.
# For local AI verification set AI_PROVIDER=ollama in your private .env file.
AI_PROVIDER=mock
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:4b
OLLAMA_THINK=false
# Append-only local project history used by the portfolio baseline.
PROJECT_HISTORY_PATH=.runtime/project-history.jsonl
AUDIT_PATH=.runtime/audit.jsonl

# Future live adapters. Leave blank for mock/draft mode.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
EMAIL_PROVIDER_API_KEY=
